.ledger-detail-view {
  padding: 0;
  box-sizing: border-box;
  width: 100%;
}

/* 为左下角 fixed「记一笔」留出滚动到底时的留白 */
.ledger-detail-view--fab {
  padding-bottom: calc(136rpx + env(safe-area-inset-bottom));
}

.hint {
  color: #6e7788;
  font-size: 28rpx;
  margin-top: 24rpx;
}

.detail-full-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx 80rpx;
  box-sizing: border-box;
}

.detail-loading-illu {
  width: 520rpx;
  max-width: 100%;
  border-radius: 24rpx;
}

.detail-loading-text {
  margin-top: 28rpx;
  font-size: 28rpx;
  color: #6e7788;
}

.tx-loading-wrap {
  margin-top: 4rpx;
  padding: 40rpx 24rpx 48rpx;
  border-radius: 22rpx;
  background: #f7f9fc;
  border: 1rpx solid #e3ebf7;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tx-loading-illu {
  width: 400rpx;
  max-width: 100%;
  border-radius: 18rpx;
}

.tx-loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #6e7788;
}

.header {
  margin-bottom: 16rpx;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
}

.title-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.pending-box {
  margin-top: 24rpx;
}

.pending-title {
  font-size: 32rpx;
  color: #20283a;
  font-weight: 600;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  flex: 1;
  min-width: 0;
}

.btn-more {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
}

.btn-more:active {
  background: rgba(0, 0, 0, 0.04);
}

.btn-more-dots {
  font-size: 44rpx;
  line-height: 1;
  color: #666666;
  font-weight: 700;
}

.btn-secondary {
  width: 100%;
  background: #f5f6f8;
  color: #2f3a45;
  border-radius: 14rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
}

.share-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #728095;
  line-height: 1.5;
}

.pending-entry {
  margin-top: 14rpx;
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #8a5400;
  background: #fff6e5;
  border: 1rpx solid #ffd08a;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 28rpx 0 16rpx;
}

.section-title {
  font-size: 32rpx;
  color: #1a1a1a;
  margin: 0;
  font-weight: 700;
  flex: 1;
  min-width: 0;
}

.btn-inline-record {
  flex-shrink: 0;
  margin: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #0066ff;
  color: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(0, 102, 255, 0.2);
}


.summary-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.detail-analytics-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f4f8ff 0%, #eef5ff 55%, #f8fbff 100%);
  border: 1rpx solid rgba(0, 102, 255, 0.14);
  box-shadow: 0 4rpx 14rpx rgba(0, 102, 255, 0.06);
  box-sizing: border-box;
}

.detail-analytics-entry--hover {
  opacity: 0.92;
}

.detail-analytics-entry__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.detail-analytics-entry__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.detail-analytics-entry__sub {
  font-size: 22rpx;
  color: #5c6b80;
  line-height: 1.45;
}

.detail-analytics-entry__arrow {
  flex-shrink: 0;
  font-size: 40rpx;
  line-height: 1;
  color: #0066ff;
  font-weight: 300;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 18rpx;
  border-radius: 24rpx;
  padding: 22rpx 22rpx 22rpx 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
  border: 1rpx solid transparent;
}

.summary-item--income {
  background: linear-gradient(145deg, #f4f8ff 0%, #eef4ff 100%);
  border-color: rgba(0, 102, 255, 0.12);
}

.summary-item--expense {
  background: linear-gradient(145deg, #fff8f6 0%, #fff0ed 100%);
  border-color: rgba(229, 69, 69, 0.14);
}

.summary-stripe {
  width: 8rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  align-self: stretch;
  min-height: 72rpx;
}

.summary-stripe--income {
  background: linear-gradient(180deg, #3d7eff 0%, #0066ff 100%);
  box-shadow: 0 2rpx 8rpx rgba(0, 102, 255, 0.35);
}

.summary-stripe--expense {
  background: linear-gradient(180deg, #f06b52 0%, #d4380d 100%);
  box-shadow: 0 2rpx 8rpx rgba(212, 56, 13, 0.28);
}

.summary-item-inner {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.summary-label {
  font-size: 24rpx;
  font-weight: 600;
}

.summary-label--income {
  color: #3d5a80;
}

.summary-label--expense {
  color: #8b4a42;
}

.summary-value {
  margin-top: 14rpx;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.summary-value--income {
  color: #0066ff;
}

.summary-value--expense {
  color: #d4380d;
}

.detail-budget-card {
  margin-bottom: 18rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid #e5e5e5;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
}

.detail-budget-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-budget-label {
  font-size: 24rpx;
  color: #5c6b89;
  font-weight: 600;
}

.detail-budget-amt {
  font-size: 26rpx;
  font-weight: 700;
  color: #1b2232;
}

.detail-budget-track {
  margin-top: 14rpx;
}

.detail-budget-track-bg {
  height: 12rpx;
  border-radius: 999rpx;
  background: #e8efff;
  overflow: hidden;
}

.detail-budget-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #0066ff;
  min-width: 0;
}

.detail-budget-fill.detail-budget-fill-caution {
  background: linear-gradient(120deg, #c9a227, #e8c547);
}

.detail-budget-fill.detail-budget-fill-warn {
  background: linear-gradient(120deg, #e08a00, #f5b041);
}

.detail-budget-fill.detail-budget-fill-month-end {
  background: linear-gradient(120deg, #2e9e7b, #4ecba5);
}

.detail-budget-fill.detail-budget-fill-over {
  background: linear-gradient(120deg, #e54545, #ff7a7a);
}

.detail-budget-hint {
  margin-bottom: 18rpx;
  padding: 12rpx 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
}

.detail-budget-hint-illu {
  flex: 1;
  width: auto;
  height: 88rpx;
  display: block;
  border-radius: 12rpx;
  background: #f3f7ff;
}

.detail-budget-hint-btn {
  align-self: auto;
  flex-shrink: 0;
  margin: 0;
  padding: 0 22rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #0066ff;
  background: #eef4ff;
  border-radius: 10rpx;
  border: none;
}

.detail-budget-hint-btn::after {
  border: none;
}

.detail-budget-foot {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7a859a;
  line-height: 1.45;
}

.btn-primary-record {
  position: fixed;
  left: 50%;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  z-index: 100;
  width: auto;
  min-width: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #0066ff;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(0, 102, 255, 0.22);
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #e5e5e5;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
}

.empty-wrap {
  margin-top: 4rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid #dce7ff;
  box-shadow: 0 6rpx 18rpx rgba(31, 99, 255, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-illu {
  width: 560rpx;
  max-width: 100%;
  border-radius: 18rpx;
}

.empty-title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2f53;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #738098;
  text-align: center;
}

.tx-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tx-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tx-group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #6f7d94;
  padding: 0 4rpx;
}

.tx-group-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tx-row {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.tx-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tx-line-left {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tx-meta {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: 16rpx;
}

.tx-meta-item {
  font-size: 22rpx;
  color: #8b95a8;
  line-height: 1.3;
}

.tx-meta-time {
  flex: 0 0 auto;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tx-meta-payer {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tx-meta-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  background: #eef2ff;
}

.tx-meta-payer-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tx-thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 4rpx;
}

.tx-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #f2f4f7;
  flex-shrink: 0;
}

.tx-amt {
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  margin-top: 2rpx;
}

.tx-amt-expense {
  color: #1a1a1a;
}

.tx-amt-income {
  color: #0066ff;
}

.tx-tap:active {
  opacity: 0.86;
  transform: scale(0.995);
}

.btn-primary-record::after,
.btn-inline-record::after,
.btn-secondary::after {
  border: none;
}

.archived-strip {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(120deg, #fff7e8, #ffe4bf);
  border: 1rpx solid #ffd08a;
  box-sizing: border-box;
}

.archived-strip-mark {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #8a5400;
  background: rgba(255, 255, 255, 0.72);
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
}

.archived-strip-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.archived-strip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4d2e00;
  line-height: 1.35;
}

.archived-strip-desc {
  font-size: 24rpx;
  color: #855300;
  line-height: 1.5;
}

.tx-truncate-strip {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fff7e8;
  border: 1rpx solid #ffd08a;
  box-sizing: border-box;
}

.tx-truncate-strip-mark {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #8a5400;
  background: rgba(255, 255, 255, 0.72);
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
}

.tx-truncate-strip-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #855300;
  line-height: 1.5;
}

/* 标题「⋯」底部抽屉（与 pages/ledgers 列表抽屉视觉一致） */
.detail-sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 2000;
}

.detail-sheet-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2001;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.detail-sheet-grabber {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e0e0e0;
  margin: 16rpx auto 8rpx;
}

.detail-sheet-head {
  padding: 8rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.detail-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.detail-sheet-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888888;
}

.detail-sheet-actions {
  padding: 8rpx 0;
}

.detail-sheet-row {
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.detail-sheet-row--danger {
  color: #e54545;
}

.detail-sheet-row--hover {
  background: #f5f7fb;
}

.detail-sheet-cancel-wrap {
  border-top: 12rpx solid #f0f2f6;
  padding-top: 8rpx;
}

.detail-sheet-cancel {
  padding: 24rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
}
