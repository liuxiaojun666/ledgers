<view class="form">
  <view class="seg-wrap">
    <view class="seg-pill">
      <view
        class="seg-item {{flowIndex === 0 ? 'seg-item-active' : ''}}"
        data-index="0"
        bindtap="onSegFlowTap"
      >
        支出
      </view>
      <view
        class="seg-item {{flowIndex === 1 ? 'seg-item-active' : ''}}"
        data-index="1"
        bindtap="onSegFlowTap"
      >
        收入
      </view>
    </view>
  </view>
  <view wx:if="{{ledgerNames.length}}" class="field row field-select">
    <view class="label-with-icon">
      <text class="field-icon">📒</text>
      <text class="label-row">账本</text>
    </view>
    <picker mode="selector" range="{{ledgerNames}}" value="{{ledgerIndex}}" bindchange="onLedgerPickerChange">
      <view class="picker-value">
        {{ledgerNames[ledgerIndex] || "选择账本"}}
        >
      </view>
    </picker>
  </view>
  <view class="field amount-field">
    <text class="label">金额</text>
    <input class="amount-input" type="digit" placeholder="¥ 0.00" value="{{amountInput}}" bindinput="onAmountInput" />
  </view>
  <view class="field category-block">
    <view class="category-picker-trigger" bindtap="openCategorySheet">
      <view class="category-field-header">
        <view class="label-with-icon">
          <text class="field-icon">🏷</text>
          <text class="label-row">分类</text>
        </view>
        <view class="category-picker-meta">
          <view class="category-current">{{categoryDisplayList[categoryIndex] || "请选择"}}</view>
        </view>
      </view>
    </view>
    <view class="add-cat-toggle-row">
      <text class="link-add" bindtap="toggleAddCategory">{{showAddCategory ? "收起" : "新增分类"}}</text>
    </view>
    <view wx:if="{{showAddCategory}}" class="add-cat-panel">
      <view class="add-cat-row">
        <input class="input add-cat-input" type="text" maxlength="{{categoryNameMaxLen}}" placeholder="新分类名称" value="{{newCategoryName}}" bindinput="onNewCategoryInput" />
        <button class="btn-inline-add" size="mini" bindtap="onAddCategory" loading="{{addingCategory}}" disabled="{{addingCategory}}">
          添加
        </button>
      </view>
      <view class="add-cat-section">
        <text class="add-cat-label">预置 icon</text>
        <view class="icon-grid">
          <view class="icon-item {{iconIndex === index ? 'icon-item-active' : ''}}" wx:for="{{iconOptions}}" wx:key="index" data-index="{{index}}" bindtap="onIconTap">
            {{item}}
          </view>
        </view>
      </view>
      <view class="add-cat-section">
        <text class="add-cat-label">自定义 emoji（可选）</text>
        <input class="input emoji-input-full" type="text" maxlength="8" placeholder="例如：🐶" value="{{customEmojiInput}}" bindinput="onCustomEmojiInput" />
      </view>
    </view>
    <view wx:if="{{showAddCategory}}" class="add-cat-tip">优先使用自定义 emoji；留空时使用左侧预置 icon。</view>
  </view>
  <view wx:if="{{assetPickerRange.length > 1}}" class="field row field-select">
    <view class="label-with-icon">
      <text class="field-icon">💳</text>
      <text class="label-row">资产账户</text>
    </view>
    <picker mode="selector" range="{{assetPickerRange}}" value="{{assetPickerIndex}}" bindchange="onAssetAccountPickerChange">
      <view class="picker-value">
        {{assetPickerRange[assetPickerIndex] || "不关联"}}
        >
      </view>
    </picker>
  </view>
  <view class="field row field-select">
    <view class="label-with-icon">
      <text class="field-icon">📅</text>
      <text class="label-row">记账日期</text>
    </view>
    <picker mode="date" value="{{bookDate}}" start="{{bookDateStart}}" bindchange="onBookDateChange">
      <view class="picker-value">{{bookDate || "选择日期"}} ></view>
    </picker>
  </view>
  <view class="field row field-select">
    <view class="label-with-icon">
      <text class="field-icon">🕐</text>
      <text class="label-row">记账时间</text>
    </view>
    <picker mode="time" value="{{bookTime}}" start="00:00" end="23:59" bindchange="onBookTimeChange">
      <view class="picker-value">{{bookTime || "选择时间"}} ></view>
    </picker>
  </view>
  <view class="field">
    <text class="label">备注</text>
    <input class="input" placeholder="可选" value="{{note}}" bindinput="onNoteInput" />
  </view>
  <view class="field">
    <view class="attach-head">
      <text class="label">图片</text>
      <text class="attach-count">{{attachments.length}}/{{attachMax}}</text>
    </view>
    <view class="attach-grid">
      <view class="attach-item" wx:for="{{attachments}}" wx:key="localKey">
        <image
          class="attach-img"
          src="{{item.displayUrl}}"
          mode="aspectFill"
          data-index="{{index}}"
          bindtap="onPreviewAttachment"
        />
        <view class="attach-remove" data-index="{{index}}" catchtap="onRemoveAttachment">×</view>
        <view wx:if="{{item.uploading}}" class="attach-mask">上传中</view>
      </view>
      <view
        wx:if="{{attachments.length < attachMax && !attaching}}"
        class="attach-add"
        bindtap="onAddAttachments"
      >
        +
      </view>
    </view>
    <view class="attach-tip">最多 {{attachMax}} 张，可用于小票、发票等</view>
  </view>
  <button class="btn-primary" bindtap="onSubmit" loading="{{saving}}" disabled="{{saving}}">
    {{mode === "edit" ? "保存修改" : "确认记账"}}
  </button>
  <block wx:if="{{mode === 'edit'}}">
    <button class="btn-danger" bindtap="onDelete" loading="{{deleting}}">删除本条</button>
    <view class="tip">账本内成员均可修改、删除流水；删除后不可恢复。</view>
  </block>
  <block wx:if="{{categorySheetOpen}}">
    <view class="cat-sheet-mask" catchtap="closeCategorySheet"></view>
    <view class="cat-sheet-panel">
      <view class="cat-sheet-grabber"></view>
      <view class="cat-sheet-head">
        <view class="cat-sheet-title">选择分类</view>
      </view>
      <scroll-view scroll-y class="cat-sheet-scroll">
        <view class="category-chip-grid category-chip-grid--sheet">
          <view class="category-chip {{categoryIndex === index ? 'category-chip-active' : ''}}" wx:for="{{categoryDisplayList}}" wx:key="index" data-index="{{index}}" bindtap="onCategoryTap">
            {{item}}
          </view>
        </view>
      </scroll-view>
      <view class="cat-sheet-cancel-wrap">
        <view class="cat-sheet-cancel" bindtap="closeCategorySheet">取消</view>
      </view>
    </view>
  </block>
</view>