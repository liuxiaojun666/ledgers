.page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #f6f8fc;
}

.hint {
  color: #6e778a;
  font-size: 28rpx;
  margin-top: 24rpx;
}

.header {
  margin-bottom: 24rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: -0.5rpx;
}

.sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.card {
  background: #fff;
  border-radius: 36rpx;
  padding: 36rpx;
  border: 1rpx solid #dce7ff;
  box-shadow: 0 12rpx 40rpx rgba(31, 99, 255, 0.07);
}

.card-lite {
  margin-top: 24rpx;
  border-style: dashed;
}

.label {
  font-size: 24rpx;
  color: #6a768f;
}

.value {
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #1b2232;
  letter-spacing: -0.8rpx;
}

.tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #7a859a;
  line-height: 1.5;
}

.actions {
  margin-top: 28rpx;
}

.btn-primary,
.btn-secondary {
  width: 100%;
  margin: 0;
  box-sizing: border-box;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary {
  color: #fff;
  background: linear-gradient(120deg, #1f63ff, #3f89ff);
  box-shadow: 0 10rpx 26rpx rgba(31, 99, 255, 0.2);
}

.btn-secondary {
  margin-top: 18rpx;
  color: #e54545;
  background: #fff;
  border: 1rpx solid #f0c4c4;
}

.btn-primary::after,
.btn-secondary::after {
  border: none;
}
