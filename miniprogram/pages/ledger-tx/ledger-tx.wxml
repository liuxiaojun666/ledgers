<view class="page">
  <view wx:if="{{loading}}" class="hint">加载中…</view>

  <block wx:else>
    <ledger-tx-form
      id="txUnifiedForm"
      mode="{{formMode}}"
      ledger-id="{{ledgerId}}"
      source-ledger-id="{{sourceLedgerId}}"
      tx-id="{{txId}}"
      ledger-names="{{ledgerNames}}"
      ledger-index="{{ledgerIndex}}"
      categories="{{categories}}"
      expense-categories="{{expenseCategories}}"
      income-categories="{{incomeCategories}}"
      asset-accounts="{{assetAccounts}}"
      default-asset-account-id="{{defaultAssetAccountId}}"
      bind:added="onAdded"
      bind:saved="onSaved"
      bind:deleted="onDeleted"
      bind:categoriesupdated="onCategoriesUpdated"
      bind:ledgerchange="onLedgerChange"
    />
  </block>
</view>
