.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  width: 100%;
  background: #f6f8fc;
}

.hint,
.empty {
  color: #6f798d;
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 24rpx;
}

.head {
  margin-bottom: 16rpx;
}

.crumb-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.crumb-back {
  height: 50rpx;
  box-sizing: border-box;
  padding: 0 14rpx;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: #2a67ff;
  background: #ffffff;
  border: 1rpx solid #d7e4ff;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 10rpx rgba(31, 99, 255, 0.12);
}

.crumb-back:active {
  opacity: 0.86;
}

.crumb-back-icon {
  font-size: 22rpx;
  font-weight: 700;
}

.crumb-back-text {
  font-size: 22rpx;
  font-weight: 600;
}

.crumb-text {
  font-size: 22rpx;
  color: #7b869b;
}

.head-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #1b2232;
}

.head-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7c869a;
}

.summary-card {
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #e5e5e5;
  background: #ffffff;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
}

.summary-label {
  font-size: 24rpx;
  color: #666666;
}

.summary-value {
  margin-top: 8rpx;
  font-size: 44rpx;
  line-height: 1.1;
  font-weight: 700;
}

.summary-value.summary-pos,
.summary-value.summary-zero {
  color: #1a1a1a;
}

.summary-value.summary-neg {
  color: #e54545;
}

.summary-meta {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #999999;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.row {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  border: none;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
}

.row-tap:active {
  opacity: 0.9;
}

.row-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.row-label {
  font-size: 28rpx;
  color: #25314b;
  font-weight: 600;
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-amt {
  font-size: 28rpx;
  font-weight: 700;
  color: #2f3951;
}

.row-amt.amt-pos {
  color: #0066ff;
}

.row-amt.amt-neg {
  color: #1a1a1a;
}

.row-amt.amt-zero {
  color: #7f8ca3;
}

.row-meta {
  font-size: 24rpx;
  color: #7f8ba1;
  margin-bottom: 10rpx;
}

.bar-bg {
  height: 12rpx;
  border-radius: 6rpx;
  background: #e9effc;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: #0066ff;
  min-width: 4rpx;
}

.tx {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  border: none;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
}

.tx-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tx-cat {
  font-size: 24rpx;
  color: #4767b5;
  background: #edf3ff;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  line-height: 1.3;
}

.tx-amt {
  font-size: 32rpx;
  font-weight: 700;
}

.tx-amt-expense {
  color: #1f2f53;
}

.tx-amt-income {
  color: #1f63ff;
}

.tx-note {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #334361;
}

.tx-meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.tx-meta-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  flex-shrink: 0;
}

.tx-meta-text {
  font-size: 24rpx;
  color: #8e99ae;
}

.tx-tap:active {
  opacity: 0.88;
}
