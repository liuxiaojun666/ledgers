<view class="page">
  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <block wx:else>
    <view wx:if="{{!ledgers.length}}" class="empty">暂无可统计账本，请先在「账本」创建或加入账本。</view>
    <block wx:else>
      <view wx:if="{{ledgers.length}}" class="ledger-picker-wrap">
        <view class="ledger-picker-label" bindtap="onScopePickerOpen">
          <text class="ledger-picker-text">统计：{{scopeLabel || "全部账本"}}</text>
          <text class="ledger-picker-caret">▼</text>
        </view>
      </view>
      <view class="tabs">
        <view class="tab {{range === 'week' ? 'active' : ''}}" data-range="week" bindtap="onRangeTap">
          周
        </view>
        <view class="tab {{range === 'month' ? 'active' : ''}}" data-range="month" bindtap="onRangeTap">
          月
        </view>
        <view class="tab {{range === 'year' ? 'active' : ''}}" data-range="year" bindtap="onRangeTap">
          年
        </view>
      </view>
      <view wx:if="{{range === 'month' || range === 'week' || range === 'year'}}" class="period-section">
        <view class="period-section-title">
          选择{{range === 'week' ? '周' : range === 'month' ? '月' : '年'}}度（共 {{periodChipCount}} 期）
        </view>
        <scroll-view class="period-chip-scroll" scroll-x="{{true}}" scroll-into-view="{{periodScrollIntoView}}" show-scrollbar="{{false}}">
          <view class="period-chip-row">
            <view wx:for="{{periodChips}}" wx:key="key" id="period-chip-{{item.key}}" class="period-chip {{item.active ? 'period-chip-active' : ''}}" data-kind="{{item.kind}}" data-year="{{item.year}}" data-month="{{item.month}}" data-monday="{{item.weekMondayYmd}}" bindtap="onPeriodChipTap">
              {{item.label}}
            </view>
          </view>
        </scroll-view>
      </view>
      <view class="summary">
        <view class="summary-range">{{rangeLabel}}</view>
        <view class="summary-net-label">净额（收入为正、支出为负）</view>
        <view class="summary-total {{netTone}}">{{netAmountDisplay}}</view>
        <view class="summary-flows">
          <text class="flow-expense">支出 ¥{{totalExpenseYuan}}</text>
          <text class="flow-sep">·</text>
          <text class="flow-income">收入 ¥{{totalIncomeYuan}}</text>
        </view>
        <view class="summary-meta">净额已含收支 · 共 {{txCount}} 笔 · 下方排行仅统计支出流水</view>
      </view>
      <view wx:if="{{showBudgetVs}}" class="budget-vs-card">
        <view class="budget-vs-head">
          <text class="budget-vs-title">本月支出 vs 预算</text>
          <text class="budget-vs-pct {{budgetPctTone}}">{{budgetUsedPercentDisplay}}%</text>
        </view>
        <view class="budget-vs-meta">
          <text>已用 ¥{{totalExpenseYuan}}</text>
          <text>预算 ¥{{budgetYuan}}</text>
        </view>
        <view class="budget-vs-track">
          <view class="budget-vs-track-bg">
            <view class="budget-vs-fill {{budgetFillClass}}" style="width: {{budgetBarWidth}}%;"></view>
          </view>
        </view>
        <view class="budget-vs-foot">{{budgetFootText}}</view>
      </view>
      <view class="insight-card">
        <view class="insight-text">{{insightText}}</view>
        <view class="insight-icon">✦</view>
      </view>
      <view wx:if="{{showLineChart && !scopeSheetOpen}}" class="chart-card">
        <view class="chart-head chart-head-line">
          <text class="chart-title">收支趋势</text>
          <view class="trend-kind-seg">
            <view class="trend-kind-item {{trendKind === 'expense' ? 'active' : ''}}" data-kind="expense" bindtap="onTrendKindTap">
              支出
            </view>
            <view class="trend-kind-item {{trendKind === 'income' ? 'active' : ''}}" data-kind="income" bindtap="onTrendKindTap">
              收入
            </view>
          </view>
        </view>
        <view class="chart-canvas-wrap">
          <ff-canvas id="ff-line" canvas-id="ledgerAlLine" opts="{{chartOpts}}"></ff-canvas>
        </view>
      </view>
      <view wx:if="{{showPieChart && !scopeSheetOpen}}" class="chart-card">
        <view class="chart-head chart-head-line">
          <text class="chart-title">金额占比</text>
          <view class="trend-kind-seg">
            <view class="trend-kind-item {{trendKind === 'expense' ? 'active' : ''}}" data-kind="expense" bindtap="onTrendKindTap">
              支出
            </view>
            <view class="trend-kind-item {{trendKind === 'income' ? 'active' : ''}}" data-kind="income" bindtap="onTrendKindTap">
              收入
            </view>
          </view>
        </view>
        <view wx:if="{{pieChartCurrentEmpty}}" class="chart-empty-hint">
          <text wx:if="{{trendKind === 'income'}}">该时段暂无收入分类数据</text>
          <text wx:else>该时段暂无支出分类数据</text>
        </view>
        <view wx:else class="chart-canvas-wrap">
          <ff-canvas id="ff-pie" canvas-id="ledgerAlPie" opts="{{chartOpts}}"></ff-canvas>
        </view>
      </view>
      <view wx:if="{{!groupsCategory.length && !groupsPerson.length}}" class="empty">该时段暂无流水。</view>
      <block wx:else>
        <view wx:if="{{listLoading}}" class="list-loading">列表刷新中…</view>
        <view class="list-section">
          <view class="list-section-title">支出排行榜</view>
          <view class="list">
            <view class="row row-tap" wx:for="{{groupsCategory}}" wx:key="key" data-key="{{item.key}}" data-dim="category" bindtap="onGroupRowTap">
              <view class="row-top">
                <text class="row-label">{{item.label}}</text>
                <text class="row-amt {{item.amtTone}}">{{item.rowAmtDisplay}}</text>
              </view>
              <view class="row-meta">{{item.count}} 笔 · 占 {{item.percent}}%</view>
              <view class="bar-bg">
                <view class="bar-fill" style="width: {{item.barWidth}}%;"></view>
              </view>
            </view>
          </view>
        </view>
        <view class="list-section">
          <view class="list-section-title">成员支出排行</view>
          <view class="list">
            <view class="row row-tap" wx:for="{{groupsPerson}}" wx:key="key" data-key="{{item.key}}" data-dim="person" bindtap="onGroupRowTap">
              <view class="row-top">
                <view class="row-person">
                  <image
                    wx:if="{{item.avatarUrl}}"
                    class="member-avatar"
                    src="{{item.avatarUrl}}"
                    mode="aspectFill"
                  />
                  <text class="row-label row-label--person">{{item.label}}</text>
                </view>
                <text class="row-amt {{item.amtTone}}">{{item.rowAmtDisplay}}</text>
              </view>
              <view class="row-meta">{{item.count}} 笔 · 占 {{item.percent}}%</view>
              <view class="bar-bg">
                <view class="bar-fill" style="width: {{item.barWidth}}%;"></view>
              </view>
            </view>
          </view>
        </view>
      </block>
    </block>
  </block>
  <block wx:if="{{scopeSheetOpen}}">
    <view class="scope-sheet-mask" catchtap="onScopePickerClose"></view>
    <view class="scope-sheet-panel">
      <view class="scope-sheet-grabber"></view>
      <view class="scope-sheet-head">
        <view class="scope-sheet-title">选择统计范围</view>
        <view class="scope-sheet-sub">可合并多个账本统计，或保存为常用组合</view>
      </view>
      <scroll-view class="scope-sheet-body" scroll-y="{{true}}">
        <view class="scope-section">
          <view class="scope-section-title">快捷</view>
          <view
            class="scope-quick-row {{scopeMode === 'all' ? 'scope-quick-row--active' : ''}}"
            hover-class="scope-row--hover"
            bindtap="onScopeQuickAll"
          >
            全部账本
          </view>
        </view>
        <view wx:if="{{statGroups.length}}" class="scope-section">
          <view class="scope-section-title">已保存组合</view>
          <view
            wx:for="{{statGroups}}"
            wx:key="id"
            class="scope-group-row {{activeGroupId === item.id ? 'scope-group-row--active' : ''}}"
          >
            <view class="scope-group-main" data-id="{{item.id}}" bindtap="onScopeGroupTap">
              <text class="scope-group-name">{{item.name}}</text>
              <text class="scope-group-meta">{{item.ledgerCount}} 个账本</text>
            </view>
            <view class="scope-group-actions">
              <text class="scope-group-action" data-id="{{item.id}}" catchtap="onScopeGroupRename">编辑</text>
              <text class="scope-group-action scope-group-action--danger" data-id="{{item.id}}" catchtap="onScopeGroupDelete">删除</text>
            </view>
          </view>
        </view>
        <view class="scope-section">
          <view class="scope-section-title">勾选账本</view>
          <view
            wx:for="{{scopeLedgerRows}}"
            wx:key="_id"
            class="scope-ledger-row"
            hover-class="scope-row--hover"
            data-id="{{item._id}}"
            bindtap="onScopeLedgerToggle"
          >
            <text class="scope-ledger-check {{item.checked ? 'scope-ledger-check--on' : ''}}">{{item.checked ? '✓' : ''}}</text>
            <text class="scope-ledger-name">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="scope-sheet-foot">
        <button class="scope-btn scope-btn--ghost" bindtap="onScopeSaveGroup">保存为组合</button>
        <button class="scope-btn scope-btn--primary" bindtap="onScopeApplyMulti">应用所选</button>
      </view>
      <view class="scope-sheet-cancel-wrap">
        <view class="scope-sheet-cancel" hover-class="scope-row--hover" bindtap="onScopePickerClose">取消</view>
      </view>
    </view>
  </block>
</view>
