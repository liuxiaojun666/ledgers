<view class="page">
  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <block wx:else>
    <view wx:if="{{status === 'completed'}}" class="done-tip">该定时为一次性任务且已执行完毕，可删除后重新创建。</view>
    <view class="hero-card">
      <view class="hero-main">快速定时</view>
      <view class="hero-sub">一键创建自动记账</view>
      <image class="hero-image" src="../../images/LmtpX.png" mode="aspectFill" />
    </view>
    <view class="flow-tabs">
      <view class="flow-tab {{flowIndex === 0 ? 'active' : ''}} {{status === 'completed' ? 'disabled' : ''}}" data-index="0" bindtap="onFlowTabTap">
        支出
      </view>
      <view class="flow-tab {{flowIndex === 1 ? 'active' : ''}} {{status === 'completed' ? 'disabled' : ''}}" data-index="1" bindtap="onFlowTabTap">
        收入
      </view>
    </view>
    <view class="amount-card">
      <view class="amount-label">金额</view>
      <view class="amount-input-row">
        <text class="amount-prefix">¥</text>
        <input class="amount-input" type="digit" placeholder="0.00" value="{{amountInput}}" bindinput="onAmountInput" disabled="{{status === 'completed'}}" />
      </view>
    </view>
    <picker mode="selector" range="{{ledgerNames}}" value="{{ledgerIndex}}" bindchange="onLedgerChange" disabled="{{status === 'completed'}}">
      <view class="field-row">
        <text class="field-label">账本</text>
        <view class="field-value">{{ledgerNames[ledgerIndex]}}</view>
      </view>
    </picker>
    <view class="field-row category-panel-row {{status === 'completed' ? 'category-panel-row--disabled' : ''}}" bindtap="onOpenCategorySheet">
      <text class="field-label">分类</text>
      <view class="field-value category-panel-value">
        <text class="category-panel-text">{{categoryDisplayList[categoryIndex] || "请选择"}}</text>
      </view>
    </view>
    <picker wx:if="{{assetPickerRange.length > 1}}" mode="selector" range="{{assetPickerRange}}" value="{{assetPickerIndex}}" bindchange="onAssetAccountPickerChange" disabled="{{status === 'completed'}}">
      <view class="field-row">
        <text class="field-label">资产账户</text>
        <view class="field-value">{{assetPickerRange[assetPickerIndex] || "不关联"}}</view>
      </view>
    </picker>
    <picker mode="selector" range="{{recurrenceLabels}}" value="{{recurrenceIndex}}" bindchange="onRecurrenceChange" disabled="{{status === 'completed'}}">
      <view class="field-row">
        <text class="field-label">重复</text>
        <view class="field-value">{{recurrenceLabels[recurrenceIndex]}}</view>
      </view>
    </picker>
    <picker wx:if="{{recurrenceIndex === 0}}" mode="date" value="{{onceDate}}" bindchange="onOnceDateChange" disabled="{{status === 'completed'}}">
      <view class="field-row">
        <text class="field-label">执行日期</text>
        <view class="field-value">{{onceDate}}</view>
      </view>
    </picker>
    <picker wx:if="{{recurrenceIndex === 2}}" mode="selector" range="{{weekdayLabels}}" value="{{weekdayIndex}}" bindchange="onWeekdayChange" disabled="{{status === 'completed'}}">
      <view class="field-row">
        <text class="field-label">星期</text>
        <view class="field-value">{{weekdayLabels[weekdayIndex]}}</view>
      </view>
    </picker>
    <picker wx:if="{{recurrenceIndex === 3}}" mode="selector" range="{{monthDayLabels}}" value="{{monthDayIndex}}" bindchange="onMonthDayChange" disabled="{{status === 'completed'}}">
      <view class="field-row">
        <text class="field-label">每月几号</text>
        <view class="field-value">{{monthDayLabels[monthDayIndex]}}</view>
      </view>
    </picker>
    <picker wx:if="{{recurrenceIndex === 4}}" mode="selector" range="{{yearMonthLabels}}" value="{{yearMonthIndex}}" bindchange="onYearMonthChange" disabled="{{status === 'completed'}}">
      <view class="field-row">
        <text class="field-label">月份</text>
        <view class="field-value">{{yearMonthLabels[yearMonthIndex]}}</view>
      </view>
    </picker>
    <picker wx:if="{{recurrenceIndex === 4}}" mode="selector" range="{{yearDayLabels}}" value="{{yearDayIndex}}" bindchange="onYearDayChange" disabled="{{status === 'completed'}}">
      <view class="field-row">
        <text class="field-label">日期</text>
        <view class="field-value">{{yearDayLabels[yearDayIndex]}}</view>
      </view>
    </picker>
    <view class="note-card">
      <text class="field-label">备注（可选）</text>
      <input class="note-input" placeholder="如：房租" value="{{note}}" bindinput="onNoteInput" disabled="{{status === 'completed'}}" />
    </view>
    <view class="field-row" wx:if="{{mode === 'edit'}}">
      <text class="field-label">启用</text>
      <switch checked="{{enabled}}" bindchange="onEnabledChange" disabled="{{status === 'completed'}}" />
    </view>
    <view class="tip">执行日以北京时间为准，精确到日期（每天凌晨批量检查）；每月/每年重复仅支持 1～28 日。</view>
    <button wx:if="{{mode === 'edit'}}" class="btn-danger" bindtap="onDelete" loading="{{deleting}}">
      删除定时
    </button>
    <view class="footer-actions">
      <button class="btn-primary" bindtap="onSave" loading="{{saving}}" disabled="{{status === 'completed'}}">
        {{mode === "edit" ? "保存" : "创建"}}
      </button>
    </view>
    <block wx:if="{{categorySheetOpen}}">
      <view class="schedule-cat-sheet-mask" catchtap="closeCategorySheet"></view>
      <view class="schedule-cat-sheet-panel">
        <view class="schedule-cat-sheet-grabber"></view>
        <view class="schedule-cat-sheet-head">
          <view class="schedule-cat-sheet-title">选择分类</view>
        </view>
        <scroll-view scroll-y class="schedule-cat-sheet-scroll">
          <view class="category-flat-grid">
            <view class="schedule-category-chip {{categoryIndex === index ? 'schedule-category-chip-active' : ''}}" wx:for="{{categoryDisplayList}}" wx:key="index" data-index="{{index}}" bindtap="onCategoryTap">
              {{item}}
            </view>
          </view>
        </scroll-view>
        <view class="schedule-cat-sheet-cancel-wrap">
          <view class="schedule-cat-sheet-cancel" bindtap="closeCategorySheet">取消</view>
        </view>
      </view>
    </block>
  </block>
</view>