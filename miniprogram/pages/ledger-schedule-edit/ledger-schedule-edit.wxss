.page {
  min-height: 100vh;
  background: #f6f8fc;
  padding: 24rpx 28rpx calc(220rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hint {
  color: #6f798d;
  font-size: 28rpx;
  margin: 40rpx 0 0;
  text-align: center;
}

.done-tip {
  margin-bottom: 16rpx;
  padding: 16rpx 18rpx;
  background: #fff8e6;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #996600;
}

.hero-card {
  border-radius: 24rpx;
  min-height: 152rpx;
  padding: 22rpx;
  background: linear-gradient(120deg, #4a86f6, #2f66eb);
  color: #ffffff;
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.hero-main {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-sub {
  margin-top: 6rpx;
  font-size: 26rpx;
  opacity: 0.95;
}

.hero-image {
  position: absolute;
  right: 14rpx;
  bottom: 10rpx;
  width: 130rpx;
  height: 104rpx;
  border-radius: 18rpx;
  opacity: 0.95;
}

.flow-tabs {
  display: inline-flex;
  margin-bottom: 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #dce7ff;
  padding: 4rpx;
}

.flow-tab {
  min-width: 112rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #748099;
}

.flow-tab.active {
  background: linear-gradient(120deg, #2a68ff, #4c82ff);
  color: #ffffff;
  font-weight: 700;
}

.flow-tab.disabled {
  opacity: 0.55;
}

.amount-card {
  background: #ffffff;
  border: 1rpx solid #dce7ff;
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
}

.amount-label {
  color: #7a859b;
  font-size: 26rpx;
}

.amount-input-row {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
}

.amount-prefix {
  font-size: 58rpx;
  line-height: 1;
  color: #1f63ff;
  font-weight: 700;
}

.amount-input {
  flex: 1;
  margin-left: 8rpx;
  min-width: 0;
  font-size: 64rpx;
  line-height: 1.1;
  color: #1f4fbd;
  font-weight: 700;
}

.field-row {
  background: #ffffff;
  border: 1rpx solid #dce7ff;
  border-radius: 20rpx;
  min-height: 84rpx;
  padding: 0 22rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-label {
  font-size: 28rpx;
  color: #2a3243;
}

.field-value {
  max-width: 62%;
  text-align: right;
  color: #6c7891;
  font-size: 30rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.note-card {
  background: #ffffff;
  border: 1rpx solid #dce7ff;
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 14rpx;
}

.note-input {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #1f2f53;
  min-height: 44rpx;
}

.tip {
  margin: 10rpx 4rpx 0;
  font-size: 23rpx;
  color: #8a94a8;
  line-height: 1.6;
}

.btn-danger {
  width: 100%;
  margin-top: 16rpx;
  background: #fff;
  color: #e54545;
  border: 1rpx solid #f3b4b4;
  border-radius: 12rpx;
  font-size: 28rpx;
  height: 84rpx;
  line-height: 84rpx;
}

.footer-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #f6f8fc 65%, rgba(246, 248, 252, 0));
}

.btn-primary {
  width: 100%;
  border-radius: 18rpx;
  vertical-align: middle;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(120deg, #3f7ff5, #255fe8);
}
