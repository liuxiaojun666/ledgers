<view class="page">
  <view class="profile-card">
    <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{profileAvatarUrl}}" class="avatar avatar-image" src="{{profileAvatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar">👤</view>
    </button>
    <view class="profile-meta">
      <view class="profile-name profile-name-clickable" bindtap="promptProfileNickname">
        {{profileNickName || "微信用户"}}
      </view>
      <view class="profile-desc">已加入 {{joinedLedgerCount || 0}} 个账本</view>
    </view>
  </view>
  <view class="card-row" bindtap="openManageCategories">
    <view class="card-left">
      <text class="card-icon">📂</text>
      <text class="card-title">分类管理</text>
    </view>
    <text class="card-link">{{categoriesLoading ? "加载中..." : "去管理 >"}}</text>
  </view>
  <view class="card-row" bindtap="openSchedules">
    <view class="card-left">
      <text class="card-icon">⏰</text>
      <text class="card-title">定时记账</text>
    </view>
    <text class="card-link">去管理 ></text>
  </view>
  <button wx:if="{{showEmptyLedgerCreate}}" class="btn-create" bindtap="createLedger">
    + 新建账本
  </button>
</view>