<view class="page">
  <view wx:if="{{accountName}}" class="head">
    <view class="head-sub head-sub--account">{{accountName}}</view>
  </view>
  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <view wx:if="{{loadState === 'error' && errorText}}" class="state-banner tone-danger-banner">
    <text class="state-banner-icon">!</text>
    <text class="state-banner-text">{{errorText}}</text>
  </view>
  <view wx:if="{{!loading && loadState !== 'error' && !flatRows.length}}" class="hint">暂无记录</view>
  <block wx:elif="{{!loading && flatRows.length}}">
    <block wx:for="{{flatRows}}" wx:key="rk">
      <view wx:if="{{item.kind === 'section'}}" class="section-label">{{item.sectionLabel}}</view>
      <view
        wx:else
        class="record-row tone-{{item.detail.tone}} {{item.detail.transferRowExtras}}"
      >
        <view class="record-main">
          <view class="record-head">
            <text class="record-title">{{item.detail.firstLineTitle}}</text>
            <text class="record-amt amt-{{item.detail.tone}}">{{item.detail.amtColumn}}</text>
          </view>
          <view wx:if="{{item.detail.hasTransferPair && item.detail.counterpartyAccountName}}" class="record-sub">
            对端账户：{{item.detail.counterpartyAccountName}}
          </view>
          <view wx:if="{{item.detail.displayNote}}" class="record-note">{{item.detail.displayNote}}</view>
          <view class="record-tail">
            <text class="record-balance">余额 ¥{{item.detail.afterBalanceYuan}}</text>
            <text wx:if="{{item.detail.bookedAtLabel}}" class="record-time">{{item.detail.bookedAtLabel}}</text>
          </view>
        </view>
      </view>
    </block>
  </block>
</view>
