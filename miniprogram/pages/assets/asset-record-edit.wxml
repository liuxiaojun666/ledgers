<view class="page">
  <view class="form">
    <view class="item">
      <view class="label">账户</view>
      <view class="value">{{accountName || "未命名账户"}}</view>
    </view>
    <view class="item">
      <view class="label">变动类型</view>
      <picker mode="selector" range="{{actionOptions}}" range-key="label" value="{{actionIndex}}" bindchange="onActionChange">
        <view class="picker">{{actionOptions[actionIndex].label}}</view>
      </picker>
    </view>
    <view class="item">
      <view class="label">金额（元）</view>
      <input class="input" type="digit" value="{{amountYuan}}" bindinput="onAmountInput" placeholder="请输入金额" />
    </view>
    <view class="item">
      <view class="label">记账日期</view>
      <picker mode="date" value="{{bookedAtDate}}" start="{{minBookedAtDate}}" bindchange="onDateChange">
        <view class="picker">{{bookedAtDate || "选择日期"}}</view>
      </picker>
    </view>
    <view class="item">
      <view class="label">时间</view>
      <picker mode="time" value="{{bookedAtTime}}" start="00:00" end="23:59" bindchange="onTimeChange">
        <view class="picker">{{bookedAtTime || "选择时间"}}</view>
      </picker>
    </view>
    <view class="item">
      <view class="label">备注</view>
      <textarea class="textarea" value="{{note}}" bindinput="onNoteInput" placeholder="可选备注" />
    </view>
    <view wx:if="{{actionType !== 'adjust'}}" class="item">
      <view class="label">同步到账本</view>
      <switch checked="{{syncToLedger}}" bindchange="onSyncToggle" color="#0066ff" />
    </view>
    <view wx:if="{{actionType !== 'adjust' && syncToLedger}}" class="item">
      <view class="label">同步账本</view>
      <picker mode="selector" range="{{ledgerOptions}}" range-key="name" value="{{ledgerIndex}}" bindchange="onLedgerChange">
        <view class="picker">{{ledgerOptions.length ? ledgerOptions[ledgerIndex].name : "暂无可用账本"}}</view>
      </picker>
    </view>
    <view wx:if="{{actionType !== 'adjust' && syncToLedger}}" class="item">
      <view class="label">同步分类</view>
      <picker mode="selector" range="{{categoryOptions}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker">{{categoryOptions.length ? categoryOptions[categoryIndex] : "暂无分类"}}</view>
      </picker>
    </view>
  </view>
  <button class="btn" loading="{{submitting}}" bindtap="onSubmit">保存</button>
</view>
