/* jizhang.pen「12-资产变动记录-V3」色值与设计语言（192rpx≈画布 390 CSS px） */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f2f6ff 0%, #fbfcff 55%, #fbfcff 100%);
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.head {
  margin-bottom: 12rpx;
}

.head-sub {
  font-size: 24rpx;
  color: #667085;
}

.head-sub--account {
  font-size: 26rpx;
  font-weight: 600;
  color: #101828;
}

.hint {
  color: #64748b;
  font-size: 26rpx;
}

.section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #667085;
  margin: 8rpx 0 12rpx 4rpx;
}

.record-row {
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 28rpx;
  border: 1rpx solid #e2e8f0;
  box-sizing: border-box;
  background: #ffffff;
}

.record-main {
  width: 100%;
  min-width: 0;
}

.record-head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.record-tail {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.record-row--xfer {
  background: #ffffff;
  border-color: #dfe8fb;
}

.record-row--xfer-start {
  border-bottom-left-radius: 16rpx;
  border-bottom-right-radius: 16rpx;
  margin-bottom: -6rpx;
}

.record-row--xfer-end {
  border-top-left-radius: 16rpx;
  border-top-right-radius: 16rpx;
}

.record-row--xfer-middle {
  border-radius: 16rpx;
  margin-bottom: -6rpx;
}

.record-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
  min-width: 0;
  color: #101828;
}

.record-amt.amt-expense {
  color: #b42318;
}

.record-amt.amt-income,
.record-amt.amt-adjust {
  color: #0f766e;
}

.record-amt.amt-transfer {
  color: #1d4ed8;
}

.record-amt.amt-neutral {
  color: #101828;
}

.record-balance {
  flex: 1;
  font-size: 22rpx;
  font-weight: 500;
  color: #475569;
  line-height: 1.35;
  min-width: 0;
}

.record-time {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 500;
  color: #64748b;
  line-height: 1.35;
}

.record-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
}

.record-note {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #1e293b;
  font-weight: 500;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 10rpx 12rpx;
}

.record-amt {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.state-banner {
  margin-top: 16rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid #fecaca;
  background: #fff6f6;
}

.tone-danger-banner .state-banner-icon {
  color: #b42318;
}

.state-banner-icon {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.state-banner-text {
  flex: 1;
  font-size: 24rpx;
  color: #b42318;
  line-height: 1.45;
}
