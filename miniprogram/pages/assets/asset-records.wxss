.page {
  min-height: 100vh;
  background: #f6f8fc;
  padding: 24rpx;
  box-sizing: border-box;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2940;
}

.btn-add {
  margin: 0;
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #0066ff;
  color: #fff;
  font-size: 24rpx;
}
.btn-add::after {
  border: none;
}

.hint {
  color: #66758f;
  font-size: 26rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.row {
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #e7ecfb;
  padding: 18rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.row-transfer {
  border-color: #cfe0ff;
  background: #f8fbff;
}

.row-transfer-start {
  border-bottom-left-radius: 8rpx;
  border-bottom-right-radius: 8rpx;
  margin-bottom: -4rpx;
}

.row-transfer-end {
  border-top-left-radius: 8rpx;
  border-top-right-radius: 8rpx;
}

.row-transfer-middle {
  border-radius: 8rpx;
  margin-bottom: -4rpx;
}

.row-title {
  font-size: 28rpx;
  color: #1f2940;
  font-weight: 700;
}
.transfer-pill {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: #0066ff;
  background: rgba(0, 102, 255, 0.08);
  border: 1rpx solid rgba(0, 102, 255, 0.25);
  border-radius: 999rpx;
  padding: 2rpx 10rpx;
  font-weight: 500;
}
.row-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6f7f9d;
}
.row-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #2d3a57;
}

.del {
  color: #d94b4b;
  font-size: 24rpx;
}
