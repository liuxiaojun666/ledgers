/* 与资产首页对齐：#f6f8fc 底、#0066ff 主色 */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #f6f8fc;
}

.hint {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

/* —— 已归档提示 —— */
.archived-strip {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(120deg, #fff7e8, #ffe4bf);
  border: 1rpx solid #ffd08a;
  box-sizing: border-box;
}

.archived-strip-mark {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #8a5400;
  background: rgba(255, 255, 255, 0.72);
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
}

.archived-strip-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.archived-strip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4d2e00;
  line-height: 1.35;
}

.archived-strip-desc {
  font-size: 24rpx;
  color: #855300;
  line-height: 1.5;
}

/* —— 账户主卡片 —— */
.hero {
  margin-bottom: 24rpx;
}

.hero-card {
  padding: 28rpx;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 102, 255, 0.2);
}

.hero-card--asset {
  background: linear-gradient(135deg, #0066ff 0%, #3d8bff 55%, #5a9fff 100%);
}

.hero-card--liability {
  background: linear-gradient(135deg, #dc2626 0%, #ef4444 55%, #f87171 100%);
  box-shadow: 0 12rpx 32rpx rgba(220, 38, 38, 0.2);
}

.hero-card--archived {
  background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 55%, #fcd34d 100%);
  box-shadow: 0 12rpx 28rpx rgba(217, 119, 6, 0.18);
}

.hero-card__head {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.hero-avatar {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
}

.hero-card__meta {
  flex: 1;
  min-width: 0;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.5rpx;
}

.title-clip {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.title-edit-btn {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  box-sizing: border-box;
}

.title-edit-btn--hover {
  opacity: 0.72;
}

.title-edit-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.head-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  font-weight: 500;
}

/* —— 共享来源（主卡上方） —— */
.share-by {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.share-by__avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  border: 1rpx solid #e8ecf4;
}

.share-by__avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #0066ff;
  background: rgba(0, 102, 255, 0.1);
}

.share-by__text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.share-by__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.share-by__sub {
  font-size: 24rpx;
  color: #888888;
  line-height: 1.4;
}

/* —— 户主快捷管理 —— */
.owner-tools {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.owner-tool {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.owner-tool--hover {
  background: #f5f7fb;
}

.owner-tool--disabled {
  opacity: 0.5;
}

.owner-tool__icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.owner-tool__icon--share {
  background: rgba(0, 102, 255, 0.1);
}

.owner-tool__icon--archive {
  background: rgba(196, 90, 0, 0.1);
}

.owner-tool__img {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.owner-tool__text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.owner-tool__label {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.3;
}

.owner-tool__sub {
  font-size: 22rpx;
  color: #888888;
  line-height: 1.35;
}

/* —— 页底文字操作 —— */
.page-foot-link {
  margin-top: 40rpx;
  padding: 16rpx 0 calc(8rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 26rpx;
  color: #888888;
  font-weight: 500;
  line-height: 1.4;
}

.page-foot-link--primary {
  color: #0066ff;
}

.page-foot-link--hover {
  opacity: 0.72;
}

.page-foot-link:not(.page-foot-link--primary).page-foot-link--hover {
  color: #dc2626;
}

.page-foot-link--busy {
  opacity: 0.55;
}

.role-badge {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #0066ff;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-weight: 600;
  line-height: 1.3;
  max-width: 36%;
  text-align: center;
}

.balance {
  margin-top: 24rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.15;
}

.hero-cta {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.95);
  box-sizing: border-box;
}

.hero-cta--hover {
  opacity: 0.92;
}

.hero-cta--muted {
  background: rgba(255, 255, 255, 0.55);
}

.hero-cta-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #0066ff;
}

.hero-card--liability .hero-cta-text {
  color: #dc2626;
}

.hero-card--archived .hero-cta-text {
  color: #b45309;
}

.hero-cta--muted .hero-cta-text {
  color: #888888;
  font-weight: 600;
}

/* —— 最近变动 —— */
.recent-section {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx 8rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
}

.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  margin-bottom: 4rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.recent-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.recent-link {
  font-size: 24rpx;
  font-weight: 600;
  color: #0066ff;
}

.recent-link--hover {
  opacity: 0.75;
}

.recent-empty {
  padding: 32rpx 0 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #888888;
}

.recent-err {
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #dc2626;
  text-align: center;
}

.rec-sec {
  font-size: 24rpx;
  font-weight: 600;
  color: #888888;
  padding: 20rpx 0 8rpx;
}

.record-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  box-sizing: border-box;
}

.record-row:last-child {
  border-bottom: none;
}

.record-main {
  width: 100%;
  min-width: 0;
}

.record-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.record-tail {
  margin-top: 12rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.record-row--xfer-start {
  border-bottom: none;
  padding-bottom: 12rpx;
}

.record-row--xfer-end {
  padding-top: 12rpx;
  background: #fafbfc;
  margin: 0 -28rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
  border-radius: 0 0 16rpx 16rpx;
}

.record-row--xfer-middle {
  border-bottom: none;
  padding-top: 8rpx;
  padding-bottom: 8rpx;
  background: #fafbfc;
  margin: 0 -28rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
}

.record-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  min-width: 0;
  color: #1a1a1a;
}

.record-amt {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.record-amt.amt-expense {
  color: #dc2626;
}

.record-amt.amt-income,
.record-amt.amt-adjust {
  color: #0a7a3a;
}

.record-amt.amt-transfer {
  color: #0066ff;
}

.record-amt.amt-neutral {
  color: #1a1a1a;
}

.record-balance {
  flex: 1;
  font-size: 22rpx;
  color: #888888;
  line-height: 1.35;
  min-width: 0;
}

.record-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #aaaaaa;
  line-height: 1.35;
}

.record-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #888888;
  line-height: 1.4;
}

.record-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666666;
  background: #f6f8fc;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  line-height: 1.45;
}

.fallback-box {
  margin-top: 24rpx;
}

.state-banner {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #fecaca;
  background: #fff7f7;
}

.state-banner-icon {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #e54545;
}

.state-banner-text {
  flex: 1;
  font-size: 24rpx;
  color: #b42318;
  line-height: 1.45;
}
