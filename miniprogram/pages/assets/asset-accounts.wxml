<view class="page">
  <view class="head">
    <view class="head-title">{{scope === 'shared' ? '共享账户' : '我的账户'}}</view>
    <view class="head-sub">{{scope === 'shared' ? '查看共享给你的账户与权限' : '管理个人账户与余额'}}</view>
  </view>
  <view class="toolbar">
    <view class="segment">
      <view
        class="seg-item {{accountTab === 'active' ? 'seg-on' : ''}}"
        bindtap="onAccountTab"
        data-tab="active"
      >
        未归档
      </view>
      <view
        class="seg-item {{accountTab === 'archived' ? 'seg-on' : ''}}"
        bindtap="onAccountTab"
        data-tab="archived"
      >
        已归档
      </view>
    </view>
    <button class="btn-create" bindtap="onCreate" wx:if="{{scope === 'personal'}}">+ 新建账户</button>
  </view>
  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <view wx:elif="{{!list.length}}" class="hint">
    {{accountTab === 'archived' ? '暂无已归档账户' : '暂无账户，先新建一个。'}}
  </view>
  <view wx:else class="list">
    <view class="card" wx:for="{{list}}" wx:key="_id">
      <view
        class="kind kind-corner {{item.kind === 'liability' ? 'kind-liability' : 'kind-asset'}}"
      >
        {{item.kind === 'liability' ? '负债' : '资产'}}
      </view>
      <view class="card-body">
        <view class="card-left">
          <view class="card-main">
            <view class="title">{{item.name}}</view>
            <view class="meta">分类：{{item.typeLabel}}</view>
            <view class="meta meta-owner" wx:if="{{scope === 'shared'}}">
              <text>来自：</text>
              <image
                wx:if="{{item.ownerAvatarUrl}}"
                class="member-avatar"
                src="{{item.ownerAvatarUrl}}"
                mode="aspectFill"
              />
              <text>{{item.ownerNickname || "共享户主"}} · {{item.shareRoleLabel}}</text>
            </view>
            <view class="balance">¥{{item.balanceYuan}}</view>
          </view>
          <view class="actions">
            <view class="action-link" bindtap="onEdit" data-id="{{item._id}}" wx:if="{{scope === 'personal'}}">编辑</view>
            <view class="action-link" bindtap="onRecords" data-id="{{item._id}}" data-name="{{item.name}}">
              记录
            </view>
            <view class="action-link" bindtap="onShare" data-id="{{item._id}}" data-name="{{item.name}}" data-role="{{item.shareRole}}">
              共享
            </view>
            <view class="action-link" bindtap="onArchive" data-id="{{item._id}}" data-archived="{{item.archived}}" wx:if="{{scope === 'personal'}}">
              {{item.archived ? "恢复" : "归档"}}
            </view>
          </view>
        </view>
        <view class="card-btn-col">
          <button class="btn-asset-change" bindtap="onAssetChange" data-id="{{item._id}}" data-name="{{item.name}}" disabled="{{scope === 'shared'}}">
            变动/调整
          </button>
        </view>
      </view>
    </view>
  </view>
</view>