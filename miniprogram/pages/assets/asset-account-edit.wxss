.page {
  min-height: 100vh;
  background: #f6f8fc;
  padding: 24rpx;
  box-sizing: border-box;
}

.hint {
  color: #66758f;
  font-size: 26rpx;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-bottom: 180rpx;
}

.form-item {
  background: #ffffff;
  border: 1rpx solid #e7ecfb;
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
}

.form-item.inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 24rpx;
  color: #6c7d9c;
  margin-bottom: 8rpx;
}

.input,
.picker {
  font-size: 28rpx;
  color: #1f2940;
  min-height: 42rpx;
}

.input--disabled {
  color: #66758f;
}

.field-hint {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #1f2940;
}

.btn-submit {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  /* height: 84rpx; */
  line-height: 64rpx;
  border-radius: 999rpx;
  background: #0066ff;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.btn-submit::after {
  border: none;
}
