/* 与账本列表、我的页对齐：#f6f8fc 底、#0066ff 主色、24rpx 圆角卡片 */

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(208rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f6f8fc;
}

.hint {
  color: #666666;
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 24rpx;
}

/* —— 净资产主卡片 —— */
.summary-hero {
  padding: 32rpx 28rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #0066ff 0%, #3d8bff 55%, #5a9fff 100%);
  box-shadow: 0 12rpx 32rpx rgba(0, 102, 255, 0.22);
}

.summary-hero__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.summary-hero__label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  font-weight: 500;
}

.summary-badge {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  line-height: 1.2;
}

.summary-badge--up {
  color: #0a7a3a;
  background: rgba(255, 255, 255, 0.95);
}

.summary-badge--down {
  color: #c45a00;
  background: rgba(255, 255, 255, 0.95);
}

.summary-hero__amount {
  margin-top: 16rpx;
  font-size: 60rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -1rpx;
  line-height: 1.15;
}

.summary-hero__stats {
  margin-top: 24rpx;
  display: flex;
  align-items: stretch;
  padding: 20rpx 8rpx 4rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
}

.summary-stat {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.summary-stat-divider {
  width: 1rpx;
  margin: 4rpx 0;
  background: rgba(255, 255, 255, 0.28);
  flex-shrink: 0;
}

.summary-stat__label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.summary-stat__value {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.summary-stat__value--liability {
  color: #ffe4e8;
}

/* —— 快捷操作 —— */
.quick-card {
  margin-top: 24rpx;
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 8rpx 4rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
}

.quick-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 8rpx 20rpx;
  border-radius: 16rpx;
}

.quick-item--hover {
  background: #f5f7fb;
}

.quick-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.quick-icon-img {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.quick-icon--create {
  background: rgba(0, 102, 255, 0.1);
}

.quick-icon--transfer {
  background: rgba(10, 122, 58, 0.1);
}

.quick-icon--trend {
  background: rgba(196, 90, 0, 0.1);
}

.quick-icon--records {
  background: rgba(107, 76, 154, 0.1);
}

.quick-name {
  font-size: 22rpx;
  color: #1a1a1a;
  font-weight: 600;
  line-height: 1.25;
}

/* —— 账户分区 —— */
.section {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx 8rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.section-count {
  font-size: 22rpx;
  color: #888888;
  font-weight: 500;
}

.account-list {
  display: flex;
  flex-direction: column;
}

.account-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.account-row:last-child {
  border-bottom: none;
}

.account-row--hover {
  opacity: 0.82;
}

.account-avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.account-avatar--asset {
  background: linear-gradient(145deg, #4d8dff, #0066ff);
}

.account-avatar--liability {
  background: linear-gradient(145deg, #f87171, #dc2626);
}

.account-avatar--shared {
  background: linear-gradient(145deg, #a78bfa, #7c3aed);
}

.account-main {
  flex: 1;
  min-width: 0;
}

.account-name {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #888888;
}

.account-balance {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #0066ff;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.account-balance--liability {
  color: #dc2626;
}

.row-arrow {
  font-size: 32rpx;
  color: #cccccc;
  font-weight: 400;
  line-height: 1;
}

.owner-group + .owner-group {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #eeeeee;
}

.owner-title {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #0066ff;
  font-weight: 600;
  margin-bottom: 4rpx;
  padding: 6rpx 14rpx 6rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(0, 102, 255, 0.08);
  max-width: 100%;
  box-sizing: border-box;
}

.owner-title-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  flex-shrink: 0;
}

.empty-block {
  padding: 32rpx 0 40rpx;
  text-align: center;
}

.empty-block__text {
  font-size: 26rpx;
  color: #888888;
}

.empty-block__action {
  margin-top: 16rpx;
  display: inline-block;
  font-size: 26rpx;
  color: #0066ff;
  font-weight: 600;
}

.archived-entry {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

.archived-entry--hover {
  opacity: 0.75;
}

.archived-entry__arrow {
  font-size: 32rpx;
  color: #cccccc;
  line-height: 1;
}

.state-banner {
  margin-top: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #fecaca;
  background: #fff7f7;
}

.state-banner-icon {
  font-size: 28rpx;
  font-weight: 700;
  color: #e54545;
  line-height: 1.35;
}

.state-banner-text {
  flex: 1;
  font-size: 24rpx;
  color: #b42318;
  line-height: 1.45;
}
