.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(208rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f4f7ff;
}

.hint,
.empty {
  color: #666666;
  font-size: 26rpx;
}

.summary-card {
  background: linear-gradient(135deg, #1d5fff 0%, #5288ff 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.summary-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.summary-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.86);
}

.summary-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.summary-liability {
  color: #ffe7d5;
}

.summary-net {
  color: #dbf6e3;
}

.summary-net-neg {
  color: #ffe7d5;
}

.section {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #e5ebff;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2940;
  margin-bottom: 10rpx;
}

.account-list {
  display: flex;
  flex-direction: column;
}

.account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f3ff;
}

.account-row:last-child {
  border-bottom: none;
}

.account-name {
  font-size: 26rpx;
  color: #24314d;
}

.account-balance {
  font-size: 26rpx;
  font-weight: 600;
  color: #0f7a3d;
}

.account-balance.liability {
  color: #d45a0a;
}

.action-panel {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 12rpx;
  border: 1rpx solid #e5ebff;
}

.action-grid {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
}

.action-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 14rpx 4rpx;
  border-radius: 16rpx;
}

.action-item:active {
  background: #f1f5ff;
}

.action-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 38rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #edf3ff 0%, #f7f9ff 100%);
}

.action-name {
  font-size: 22rpx;
  line-height: 30rpx;
  color: #2a3650;
  text-align: center;
}
