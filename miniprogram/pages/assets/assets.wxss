.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(220rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f4f7ff;
}

.hint,
.empty {
  color: #666666;
  font-size: 26rpx;
}

.summary-card {
  background: linear-gradient(135deg, #1d5fff 0%, #5288ff 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.summary-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.summary-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.86);
}

.summary-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.summary-liability {
  color: #ffe7d5;
}

.summary-net {
  color: #dbf6e3;
}

.summary-net-neg {
  color: #ffe7d5;
}

.section {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #e5ebff;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2940;
  margin-bottom: 10rpx;
}

.account-list {
  display: flex;
  flex-direction: column;
}

.account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f3ff;
}

.account-row:last-child {
  border-bottom: none;
}

.account-name {
  font-size: 26rpx;
  color: #24314d;
}

.account-balance {
  font-size: 26rpx;
  font-weight: 600;
  color: #0f7a3d;
}

.account-balance.liability {
  color: #d45a0a;
}

.bottom-actions {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(220rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
}

.bottom-actions-second {
  bottom: calc(320rpx + env(safe-area-inset-bottom));
}

.btn-manage {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  background: #0066ff;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 30rpx rgba(0, 102, 255, 0.25);
}

.btn-outline {
  background: #ffffff;
  color: #0066ff;
  border: 1rpx solid #0066ff;
  box-shadow: none;
}

.btn-manage::after {
  border: none;
}
