.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f2f7ff 0%, #fafcff 45%, #f6f9ff 100%);
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hint {
  color: #66758f;
  font-size: 26rpx;
}

.head-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #101828;
}

.range-badge {
  font-size: 22rpx;
  color: #245bdb;
  background: #e8f0ff;
  border: 1rpx solid #c8d9ff;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-weight: 600;
}

.hero-card,
.chart-card,
.note-card {
  margin-top: 16rpx;
  background: #fff;
  border: 1rpx solid #dfe8fb;
  border-radius: 20rpx;
  padding: 22rpx 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.hero-label {
  font-size: 22rpx;
  color: #667085;
}

.hero-value {
  margin-top: 12rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: -0.5rpx;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #0f766e;
}

.chart-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2940;
}

.chart-canvas-wrap {
  margin-top: 16rpx;
  width: 100%;
  height: 400rpx;
}

ff-canvas {
  width: 100%;
  height: 400rpx;
  display: block;
}

.chart-empty {
  margin-top: 16rpx;
  padding: 48rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}

.axis-row {
  margin-top: 8rpx;
  display: flex;
  justify-content: space-between;
}

.axis-label {
  font-size: 20rpx;
  color: #64748b;
}

.note-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #1f2940;
}

.note-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.note-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #245bdb;
  font-weight: 600;
}

.state-banner {
  margin-top: 16rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid #fecaca;
  background: #fff7f7;
}

.trend-status-banner {
  box-shadow: none;
}

.tone-danger-banner .state-banner-icon {
  color: #b42318;
}

.state-banner-icon {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.state-banner-text {
  flex: 1;
  font-size: 24rpx;
  color: #b42318;
  line-height: 1.45;
}
