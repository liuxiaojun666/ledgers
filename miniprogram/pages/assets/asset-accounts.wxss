.page {
  min-height: 100vh;
  background: #f6f8fc;
  padding: 24rpx;
  box-sizing: border-box;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.segment {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: stretch;
  padding: 4rpx;
  border-radius: 999rpx;
  background: #e8edf7;
  box-sizing: border-box;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #5f6f8d;
  border-radius: 999rpx;
}

.seg-item.seg-on {
  color: #1f2940;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(31, 41, 64, 0.08);
}

.btn-create {
  margin: 0;
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #0066ff;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.btn-create::after {
  border: none;
}

.hint {
  color: #66758f;
  font-size: 26rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.card {
  position: relative;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e7ecfb;
  padding: 20rpx;
}

.card-body {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 16rpx;
}

.card-left {
  flex: 1;
  min-width: 0;
}

/* 与左侧信息区同高，按钮在右侧列内垂直居中 */
.card-btn-col {
  flex-shrink: 0;
  align-self: stretch;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.btn-asset-change {
  margin: 0;
  flex-shrink: 0;
  max-width: 200rpx;
  padding: 12rpx 16rpx;
  line-height: 1.35;
  border-radius: 999rpx;
  background: #0066ff;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.btn-asset-change::after {
  border: none;
}

.title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2940;
  padding-right: 120rpx;
  box-sizing: border-box;
}

.kind {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.kind-asset {
  color: #0f7a3d;
  background: rgba(15, 122, 61, 0.12);
}

.kind-liability {
  color: #c43d3d;
  background: rgba(196, 61, 61, 0.1);
}

.kind-corner {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 1;
}

.meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7082a3;
}

.balance {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f7a3d;
}

.actions {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.action-link {
  font-size: 24rpx;
  color: #2e62cc;
}

.action-link.danger {
  color: #d64b4b;
}
