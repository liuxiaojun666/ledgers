.page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #f6f8fc;
}

.hint {
  color: #6e778a;
  font-size: 28rpx;
  margin-top: 24rpx;
}

.header {
  margin-bottom: 8rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: -0.5rpx;
}

.sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.section {
  margin-top: 48rpx;
}

/* 蓝卡只做「邀请」 */
.section-title {
  font-size: 28rpx;
  color: #3d4a63;
  margin: 0 0 16rpx;
  font-weight: 600;
}

.section-danger {
  margin-top: 56rpx;
  padding-top: 8rpx;
}

.btn-pill {
  margin: 24rpx 0 0;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 72rpx;
  padding: 0 28rpx;
  line-height: 1;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 16rpx;
}

.btn-pill::after {
  border: none;
}

.btn-pill-primary {
  background: linear-gradient(120deg, #1f63ff, #3f89ff);
  color: #fff;
  border: none;
}

.tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7a859a;
  line-height: 1.5;
}

.danger-tip {
  margin-top: 16rpx;
  color: #9ca3af;
}

.card {
  background: #fff;
  border-radius: 36rpx;
  padding: 36rpx;
  border: 1rpx solid #dce7ff;
  box-shadow: 0 12rpx 40rpx rgba(31, 99, 255, 0.07);
}

.card-empty {
  padding: 44rpx 36rpx;
}

.card-empty-muted {
  border-color: #e5e7eb;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.04);
}

.card-lite {
  border-style: dashed;
}

.card-compact {
  padding: 28rpx 32rpx;
}

.entry-title {
  color: #2a344c;
  font-size: 30rpx;
  font-weight: 600;
}

.danger-title {
  color: #9ca3af;
  font-weight: 600;
}

.btn-delete-ledger {
  width: 100%;
  margin: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0;
  line-height: normal;
  font-size: 28rpx;
  font-weight: 500;
  background: #fff;
  color: #e54545;
  border: 1rpx solid #f0c4c4;
  border-radius: 36rpx;
  box-shadow: 0 6rpx 20rpx rgba(229, 69, 69, 0.05);
}

.btn-delete-ledger::after {
  border: none;
}

.btn-archive-ledger {
  width: 100%;
  margin: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0;
  line-height: normal;
  font-size: 28rpx;
  font-weight: 500;
  background: #fff;
  color: #b45309;
  border: 1rpx solid #fcd34d;
  border-radius: 36rpx;
  box-shadow: 0 6rpx 20rpx rgba(180, 83, 9, 0.05);
}

.btn-archive-ledger::after {
  border: none;
}

.archived-tip {
  margin-top: 24rpx;
  background: linear-gradient(120deg, #fff7e8, #ffe4bf);
  border-color: #ffd08a;
}

.archived-tip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4d2e00;
}

