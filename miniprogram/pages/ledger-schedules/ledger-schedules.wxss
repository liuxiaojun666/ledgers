.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(184rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f6f8fc;
}

.hint {
  color: #6f798d;
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 24rpx;
}

.hero-card {
  border-radius: 20rpx;
  margin-bottom: 18rpx;
  padding: 20rpx 22rpx;
  background: linear-gradient(120deg, #2a68ff, #5a92ff);
  color: #fff;
  position: relative;
  overflow: hidden;
}

.hero-main {
  font-size: 32rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.hero-icon {
  position: absolute;
  right: 18rpx;
  top: 16rpx;
  width: 68rpx;
  height: 68rpx;
  border-radius: 14rpx;
  background: #ffffff2a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.empty-wrap {
  margin-top: 8rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid #dce7ff;
  box-shadow: 0 6rpx 18rpx rgba(31, 99, 255, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-illu {
  width: 560rpx;
  max-width: 100%;
  border-radius: 18rpx;
}

.empty-title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2f53;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #738098;
  text-align: center;
}

.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #dce7ff;
  box-shadow: 0 6rpx 18rpx rgba(31, 99, 255, 0.09);
}

.card-tap:active {
  opacity: 0.92;
}

.row-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #202a3f;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #738098;
  line-height: 1.5;
}

.meta-line {
  margin-top: 4rpx;
}

.amt {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2f53;
  white-space: nowrap;
}

.amt.income {
  color: #1f63ff;
}

.switch-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #60708c;
}

.err {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #e54545;
}

.footer-action {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

.footer-action-btn {
  width: 100%;
  /* height: 88rpx; */
  line-height: 60rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(120deg, #2a68ff, #5a92ff);
  box-shadow: 0 12rpx 28rpx rgba(31, 99, 255, 0.28);
}

.footer-action-btn::after {
  border: none;
}
