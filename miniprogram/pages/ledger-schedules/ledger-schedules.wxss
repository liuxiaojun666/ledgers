.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f6f8fc;
}

.hint,
.empty {
  color: #6f798d;
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 24rpx;
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1b2232;
}

.btn-add-inline {
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e5e5e5;
  background: #ffffff;
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #0066ff;
}

.hero-card {
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  padding: 20rpx 22rpx;
  background: linear-gradient(120deg, #2a68ff, #5a92ff);
  color: #fff;
  position: relative;
  overflow: hidden;
}

.hero-main {
  font-size: 32rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.hero-icon {
  position: absolute;
  right: 18rpx;
  top: 16rpx;
  width: 68rpx;
  height: 68rpx;
  border-radius: 14rpx;
  background: #ffffff2a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #dce7ff;
  box-shadow: 0 6rpx 18rpx rgba(31, 99, 255, 0.09);
}

.card-tap:active {
  opacity: 0.92;
}

.row-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #202a3f;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #738098;
  line-height: 1.5;
}

.meta-line {
  margin-top: 4rpx;
}

.amt {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2f53;
  white-space: nowrap;
}

.amt.income {
  color: #1f63ff;
}

.switch-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #60708c;
}

.err {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #e54545;
}
