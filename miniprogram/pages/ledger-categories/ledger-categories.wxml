<view class="page">
  <view wx:if="{{loading}}" class="category-loading">
    <image class="category-loading-illu" src="/images/ledger-detail-loading.png" mode="widthFix" />
    <view class="category-loading-text">加载中…</view>
  </view>
  <block wx:else>
    <view class="hero-card">
      <!-- <view class="hero-title">分类模板库</view> -->
      <view class="hero-lead">建议优先创建常用分类，记账时录入更快、统计更清晰。</view>
      <view class="hero-meta">
        <text class="hero-meta-key">当前数量</text>
        <text class="hero-meta-value">{{categories.length}} / {{categoryMax}}</text>
      </view>
    </view>
    <view class="section section-tight">
      <view class="card">
        <view class="label">新增分类</view>
        <view class="tip">名称最多 16 个字；至少保留 1 个分类。自定义类请点选该分类属于「支出」或「收入」后再添加。</view>
        <view class="add-flow-row">
          <text class="add-flow-label">用于</text>
          <view class="add-flow-pill">
            <view
              class="add-flow-item {{newCategoryFlowIndex === 0 ? 'add-flow-item-active' : ''}}"
              data-index="0"
              bindtap="onNewCategoryFlowTap"
            >
              支出
            </view>
            <view
              class="add-flow-item {{newCategoryFlowIndex === 1 ? 'add-flow-item-active' : ''}}"
              data-index="1"
              bindtap="onNewCategoryFlowTap"
            >
              收入
            </view>
          </view>
        </view>
        <input class="input" placeholder="例如：餐饮、房租、交通" maxlength="16" value="{{newName}}" bindinput="onNewName" />
        <view class="icon-section">
          <view class="icon-label">预置 icon</view>
          <view class="icon-grid">
            <view
              class="icon-item {{iconIndex === index ? 'icon-item-active' : ''}}"
              wx:for="{{iconOptions}}"
              wx:key="index"
              data-index="{{index}}"
              bindtap="onIconTap"
            >
              {{item}}
            </view>
          </view>
        </view>
        <view class="icon-section">
          <view class="icon-label">自定义 emoji（可选）</view>
          <input class="input emoji-input-full" type="text" maxlength="8" placeholder="例如：🐶" value="{{customEmojiInput}}" bindinput="onCustomEmojiInput" />
        </view>
        <view class="tip">若填写自定义 emoji，会优先使用它；否则使用预置 icon。</view>
        <button class="btn-primary" bindtap="add" loading="{{saving}}" disabled="{{saving || !newName || !ledgerId}}">
          添加分类
        </button>
      </view>
    </view>
    <view class="section">
      <view class="section-title">当前分类（{{categories.length}}）</view>
      <view wx:if="{{!categories.length}}" class="card card-empty">
        <image class="empty-image" src="/images/LmtpX.png" mode="aspectFit" />
        <view class="empty">暂无分类，先新增一个常用分类吧</view>
      </view>
      <view wx:else class="card list-card">
        <view class="row" wx:for="{{categoryRows}}" wx:key="name">
          <view class="name-wrap">
            <text class="name">{{item.displayName}}</text>
            <text class="kind-badge">{{item.kindLabel}}</text>
          </view>
          <button class="btn-pill btn-pill-danger" data-name="{{item.name}}" bindtap="remove">删除</button>
        </view>
      </view>
    </view>
  </block>
</view>