.page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #f6f8fc;
}

.category-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 24rpx 80rpx;
  box-sizing: border-box;
}

.category-loading-illu {
  width: 520rpx;
  max-width: 100%;
  border-radius: 24rpx;
}

.category-loading-text {
  margin-top: 28rpx;
  color: #6e778a;
  font-size: 28rpx;
}

.header {
  margin-bottom: 12rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: -0.5rpx;
}

.sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.section {
  margin-top: 40rpx;
}

.section-tight {
  margin-top: 24rpx;
}

.section-title {
  font-size: 28rpx;
  color: #3d4a63;
  margin: 0 0 16rpx;
  font-weight: 600;
}

.tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7a859a;
  line-height: 1.5;
}

.hero-card {
  background: linear-gradient(135deg, #1e56f5 0%, #5590ff 100%);
  border: none;
  border-radius: 40rpx;
  padding: 40rpx;
  color: #fff;
  box-shadow: 0 20rpx 48rpx rgba(30, 86, 245, 0.28);
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-lead {
  margin-top: 14rpx;
  color: #f3f7ff;
  font-size: 26rpx;
  line-height: 1.45;
}

.hero-meta {
  margin-top: 28rpx;
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
}

.hero-meta-key {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.hero-meta-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
}

.card {
  background: #fff;
  border-radius: 36rpx;
  padding: 36rpx;
  border: 1rpx solid #dce7ff;
  box-shadow: 0 12rpx 40rpx rgba(31, 99, 255, 0.07);
}

.label {
  font-size: 24rpx;
  color: #6a768f;
}

.input {
  margin-top: 20rpx;
  border: 1rpx solid #d7e1f3;
  background: #f8faff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1b2232;
}

.btn-primary {
  width: 100%;
  margin: 20rpx 0 0;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(120deg, #1f63ff, #3f89ff);
  color: #fff;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.18);
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 26rpx rgba(31, 99, 255, 0.2);
}

.btn-primary::after {
  border: none;
}

.list-card {
  padding-top: 14rpx;
  padding-bottom: 14rpx;
}

.card-empty {
  padding: 48rpx 36rpx 44rpx;
}

.empty-image {
  width: 280rpx;
  height: 200rpx;
  display: block;
  margin: 0 auto 16rpx;
  opacity: 0.9;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 0;
}

.row + .row {
  border-top: 1rpx solid #eef2fa;
}

.name {
  font-size: 28rpx;
  font-weight: 500;
  color: #25324c;
  line-height: 1.4;
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.name-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.name-sub {
  font-size: 22rpx;
  color: #8a94a8;
}

.btn-pill {
  margin: 0;
  height: 56rpx;
  padding: 0 28rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.btn-pill::after {
  border: none;
}

.btn-pill-danger {
  background: #fff5f5;
  color: #e54545;
  border: 1rpx solid #f3bcbc;
}

.empty {
  color: #8b95a8;
  font-size: 26rpx;
  text-align: center;
  line-height: 1.5;
}

button[disabled] {
  opacity: 1;
}

button[disabled].btn-primary {
  color: rgba(255, 255, 255, 0.92);
  background: linear-gradient(120deg, #5d8cff, #78a5ff);
  box-shadow: none;
}
