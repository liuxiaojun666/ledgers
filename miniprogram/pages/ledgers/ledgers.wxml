<view class="page">
  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <block wx:elif="{{showDetailView && embeddedLedgerId}}">
    <view class="multi-ledger-banner" hover-class="multi-ledger-banner--hover" bindtap="createLedger">
      <view class="multi-ledger-banner__illus">
        <view class="multi-ledger-banner__book multi-ledger-banner__book--a" />
        <view class="multi-ledger-banner__book multi-ledger-banner__book--b" />
        <view class="multi-ledger-banner__book multi-ledger-banner__book--c" />
      </view>
      <view class="multi-ledger-banner__text">
        <view class="multi-ledger-banner__title">多账本，账目更清晰</view>
        <view class="multi-ledger-banner__desc">用不同账本区分家庭、旅行、项目等场景，互不干扰。</view>
      </view>
      <view class="multi-ledger-banner__cta">+ 新建</view>
    </view>
    <ledger-detail-view ledger-id="{{embeddedLedgerId}}" record-inline="{{true}}" bind:deleted="onEmbeddedDetailDeleted" bind:ready="onEmbeddedDetailReady" bind:hosttabbar="onEmbeddedHostTabBar" bind:pinnedchange="onEmbeddedPinnedChange" />
  </block>
  <block wx:elif="{{!list.length}}">
    <view class="multi-ledger-banner" hover-class="multi-ledger-banner--hover" bindtap="createLedger">
      <view class="multi-ledger-banner__illus">
        <view class="multi-ledger-banner__book multi-ledger-banner__book--a" />
        <view class="multi-ledger-banner__book multi-ledger-banner__book--b" />
        <view class="multi-ledger-banner__book multi-ledger-banner__book--c" />
      </view>
      <view class="multi-ledger-banner__text">
        <view class="multi-ledger-banner__title">多账本，账目更清晰</view>
        <view class="multi-ledger-banner__desc">用不同账本区分家庭、旅行、项目等场景，互不干扰。</view>
      </view>
      <view class="multi-ledger-banner__cta">+ 新建</view>
    </view>
    <view class="empty">暂无账本，先新建一个，再到协作者管理里邀请微信好友一起记。</view>
  </block>
  <view wx:else class="content">
    <view class="multi-ledger-banner" hover-class="multi-ledger-banner--hover" bindtap="createLedger">
      <view class="multi-ledger-banner__illus">
        <view class="multi-ledger-banner__book multi-ledger-banner__book--a" />
        <view class="multi-ledger-banner__book multi-ledger-banner__book--b" />
        <view class="multi-ledger-banner__book multi-ledger-banner__book--c" />
      </view>
      <view class="multi-ledger-banner__text">
        <view class="multi-ledger-banner__title">多账本，账目更清晰</view>
        <view class="multi-ledger-banner__desc">用不同账本区分家庭、旅行、项目等场景，互不干扰。</view>
      </view>
      <view class="multi-ledger-banner__cta">+ 新建</view>
    </view>
    <!-- <view class="header-row">
      <view class="page-title">我的账本</view>
      <button class="btn-new" bindtap="createLedger">+ 新建</button>
    </view> -->
    <view class="filter-seg">
      <view class="seg-item {{activeFilter === 'all' ? 'seg-item-active' : ''}}" data-filter="all" bindtap="onFilterTap">
        全部
      </view>
      <view class="seg-item {{activeFilter === 'created' ? 'seg-item-active' : ''}}" data-filter="created" bindtap="onFilterTap">
        我创建的
      </view>
      <view class="seg-item {{activeFilter === 'joined' ? 'seg-item-active' : ''}}" data-filter="joined" bindtap="onFilterTap">
        我加入的
      </view>
    </view>
    <view wx:if="{{!displayList.length}}" class="empty-inline">当前筛选下暂无账本</view>
    <view wx:else class="list">
      <view class="card" wx:for="{{displayList}}" wx:key="_id">
        <view class="card-top">
          <view class="card-main" data-id="{{item._id}}" bindtap="openDetail">
            <view class="card-title-row">
              <view class="card-title">{{item.name}}</view>
              <view wx:if="{{item.pinned}}" class="card-pin-badge">置顶</view>
            </view>
            <view class="card-month-line">
              <text class="card-month-income">
                <text class="card-month-prefix">{{item.monthSummaryLabel}}</text>收入 ¥{{item.monthIncomeYuan}}
              </text>
              <text class="card-month-expense">
                <text class="card-month-prefix">{{item.monthSummaryLabel}}</text>支出 ¥{{item.monthExpenseYuan}}
              </text>
            </view>
            <view class="card-meta">
              <text>成员 {{item.memberCount}} 人</text>
              <text class="dot">·</text>
              <text>{{item.isCreator ? "我创建" : "我加入"}}</text>
            </view>
            <view wx:if="{{item.isCreator && item.pendingRequestCount > 0}}" class="pending-entry" data-id="{{item._id}}" data-name="{{item.name}}" catchtap="openPendingPage">
              {{item.pendingRequestCount}} 条待审批申请，点击处理
            </view>
          </view>
          <view class="card-side">
            <button class="btn-record" data-id="{{item._id}}" catchtap="openRecordTx">记一笔</button>
          </view>
        </view>
      </view>
    </view>
    <view
      wx:if="{{!showDetailView}}"
      class="archived-entry"
      hover-class="archived-entry--hover"
      bindtap="openArchivedList"
    >
      <text>查看已归档账本</text>
      <text class="archived-entry__arrow">›</text>
    </view>
  </view>

  <block wx:if="{{sheetOpen}}">
    <view class="sheet-mask" catchtap="closeLedgerSheet"></view>
    <view class="sheet-panel">
      <view class="sheet-grabber" />
      <view class="sheet-head">
        <view class="sheet-title">{{sheetLedgerName || "账本"}}</view>
        <view class="sheet-sub">管理预算、名称与成员</view>
      </view>
      <view class="sheet-actions">
        <view class="sheet-row" hover-class="sheet-row--hover" bindtap="onSheetBudget">预算设置</view>
        <view class="sheet-row" hover-class="sheet-row--hover" bindtap="onSheetRename">修改账本名称</view>
        <view class="sheet-row" hover-class="sheet-row--hover" bindtap="onSheetCollaborators">协作者管理</view>
        <view class="sheet-row" hover-class="sheet-row--hover" bindtap="onSheetArchiveLedger">归档账本</view>
      </view>
      <view class="sheet-cancel-wrap">
        <view class="sheet-cancel" hover-class="sheet-row--hover" bindtap="closeLedgerSheet">取消</view>
      </view>
    </view>
  </block>
</view>