/* 与 design-exports-v2/jizhang.pen「01-账本列表」对齐 */

.page {
  padding: 32rpx 32rpx calc(208rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  background: #f6f8fc;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.page-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.btn-new {
  margin: 0;
  height: 54rpx;
  line-height: 54rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #0066ff;
  background: #ffffff;
  border: 1rpx solid #e5e5e5;
  border-radius: 999rpx;
  padding: 0 24rpx;
}

.btn-new::after,
.btn-record::after {
  border: none;
}

.hint,
.empty {
  color: #666666;
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 24rpx;
}

.filter-seg {
  display: flex;
  align-items: center;
  width: fit-content;
  max-width: 100%;
  flex-wrap: wrap;
  gap: 0;
  background: #ffffff;
  border: 1rpx solid #e5e5e5;
  border-radius: 999rpx;
  padding: 8rpx;
}

.seg-item {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  color: #666666;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.3;
}

.seg-item-active {
  color: #ffffff;
  font-weight: 600;
  background: #0066ff;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.empty-inline {
  color: #666666;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  border: none;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.card-main {
  flex: 1;
  min-width: 0;
}

.card-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.btn-record {
  margin: 0;
  box-sizing: border-box;
  width: 120px !important;
  height: 75rpx;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  background: rgba(0, 102, 255, 0.06);
  color: #0066ff;
  border: 1rpx solid #0066ff;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.card-title {
  font-size: 36rpx;
  color: #1a1a1a;
  font-weight: 700;
}

.card-meta {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666666;
}

.dot {
  margin: 0 8rpx;
}

.pending-entry {
  margin-top: 16rpx;
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #8a5400;
  background: #fff6e5;
  border: 1rpx solid #ffd08a;
}

/* 账本页通用多账本引导横条：与 design-exports-v2/jizhang.pen「01c-单账本多账本引导横条」一致 */
.multi-ledger-banner {
  box-sizing: border-box;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f0f5ff 100%);
  border-radius: 24rpx;
  border: 1rpx solid #e5e5e5;
  box-shadow: 0 4rpx 16rpx rgba(0, 102, 255, 0.06);
  position: relative;
  overflow: hidden;
}

.multi-ledger-banner__illus {
  flex-shrink: 0;
  width: 88rpx;
  height: 72rpx;
  position: relative;
}

.multi-ledger-banner__book {
  position: absolute;
  width: 40rpx;
  height: 52rpx;
  border-radius: 6rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 2rpx 8rpx rgba(0, 51, 153, 0.12);
}

.multi-ledger-banner__book--a {
  left: 0;
  bottom: 0;
  background: linear-gradient(160deg, #4d8dff 0%, #0066ff 100%);
  transform: rotate(-8deg);
  z-index: 1;
}

.multi-ledger-banner__book--b {
  left: 26rpx;
  bottom: 4rpx;
  background: linear-gradient(160deg, #7a9ef7 0%, #3d7aed 100%);
  transform: rotate(4deg);
  z-index: 2;
}

.multi-ledger-banner__book--c {
  left: 48rpx;
  bottom: 0;
  background: linear-gradient(160deg, #b8ccf9 0%, #6b9bff 100%);
  transform: rotate(12deg);
  z-index: 3;
}

.multi-ledger-banner--hover {
  opacity: 0.92;
}

.multi-ledger-banner__text {
  flex: 1;
  min-width: 0;
}

.multi-ledger-banner__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.35;
}

.multi-ledger-banner__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
}

.multi-ledger-banner__cta {
  flex-shrink: 0;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #0066ff;
  background: rgba(0, 102, 255, 0.08);
  border: 1rpx solid rgba(0, 102, 255, 0.25);
}
