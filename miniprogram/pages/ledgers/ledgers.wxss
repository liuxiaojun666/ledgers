/* 与 design-exports-v2/jizhang.pen「01-账本列表」对齐 */

.page {
  padding: 32rpx 32rpx calc(208rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  background: #f6f8fc;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.page-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.btn-new {
  margin: 0;
  height: 54rpx;
  line-height: 54rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #0066ff;
  background: #ffffff;
  border: 1rpx solid #e5e5e5;
  border-radius: 999rpx;
  padding: 0 24rpx;
}

.btn-new::after,
.btn-record::after {
  border: none;
}

.hint,
.empty {
  color: #666666;
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 24rpx;
}

.filter-seg {
  display: flex;
  align-items: center;
  width: fit-content;
  max-width: 100%;
  flex-wrap: wrap;
  gap: 0;
  background: #ffffff;
  border: 1rpx solid #e5e5e5;
  border-radius: 999rpx;
  padding: 8rpx;
}

.seg-item {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  color: #666666;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.3;
}

.seg-item-active {
  color: #ffffff;
  font-weight: 600;
  background: #0066ff;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.empty-inline {
  color: #666666;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  border: none;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.card-main {
  flex: 1;
  min-width: 0;
}

.card-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.btn-record {
  margin: 0;
  box-sizing: border-box;
  width: 120px !important;
  height: 75rpx;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  background: rgba(0, 102, 255, 0.06);
  color: #0066ff;
  border: 1rpx solid #0066ff;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.card-title {
  font-size: 36rpx;
  color: #1a1a1a;
  font-weight: 700;
}

.card-meta {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666666;
}

.dot {
  margin: 0 8rpx;
}
