.page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #f6f8fc;
}

.hint {
  color: #6e778a;
  font-size: 28rpx;
  margin-top: 24rpx;
}

.header {
  margin-bottom: 8rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: -0.5rpx;
}

.sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.section {
  margin-top: 40rpx;
}

.section-title {
  font-size: 28rpx;
  color: #3d4a63;
  margin: 0 0 16rpx;
  font-weight: 600;
}

.tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7a859a;
  line-height: 1.5;
}

.card {
  background: #fff;
  border-radius: 36rpx;
  padding: 36rpx;
  border: 1rpx solid #dce7ff;
  box-shadow: 0 12rpx 40rpx rgba(31, 99, 255, 0.07);
}

.card-lite {
  border-style: dashed;
}

.card-compact {
  padding: 28rpx 32rpx;
}

.hero-card {
  background: linear-gradient(135deg, #1e56f5 0%, #5590ff 100%);
  border: none;
  border-radius: 40rpx;
  padding: 40rpx;
  color: #fff;
  box-shadow: 0 20rpx 48rpx rgba(30, 86, 245, 0.28);
}

.hero-lead {
  color: #f3f7ff;
  font-size: 26rpx;
  line-height: 1.45;
}

.hero-btn {
  margin: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 12rpx;
  line-height: normal;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
}

.hero-btn-block {
  width: 100%;
  margin-top: 24rpx;
}

.hero-btn::after {
  border: none;
}

.member-card {
  padding: 28rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eef2fa;
}

.member-card:last-child {
  border-bottom: none;
}

.owner-row {
  padding-top: 4rpx;
}

.member-name {
  color: #2a344c;
  font-size: 28rpx;
  font-weight: 500;
}

.owner-tag {
  font-size: 22rpx;
  color: #8b96ab;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #f0f4fc;
}

.btn-pill {
  margin: 0;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 56rpx;
  padding: 0 28rpx;
  line-height: 1;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 999rpx;
}

.btn-pill::after {
  border: none;
}

.btn-pill-weak {
  background: #edf3ff;
  color: #2a67ff;
  border: 1rpx solid #d6e4ff;
}

.btn-pill-primary {
  margin-top: 20rpx;
  width: 100%;
  height: 72rpx;
  border-radius: 16rpx;
  background: linear-gradient(120deg, #1f63ff, #3f89ff);
  color: #fff;
  border: none;
}
